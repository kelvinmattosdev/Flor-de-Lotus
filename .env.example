# MODELO sem credenciais. Nao e carregado automaticamente pelo npm/Swarm.
# No Portainer, definir/importar variaveis da stack; nao usar env_file: stack.env.
APP_IMAGE=<ip_local_vps>:5000/flor-de-lotus-carlone:prototipo
OPERATOR_HOST=SEU_FQDN_OPERADOR_DISTINTO
TRAEFIK_NETWORK=SUA_OVERLAY_EXTERNA_EXISTENTE
HTTPS_ENTRYPOINT=SEU_ENTRYPOINT_HTTPS
TRAEFIK_CERTRESOLVER=SEU_RESOLVER_TLS_EXISTENTE
# Exemplo identificado: Traefik v3 com provider Swarm.
# Para v2/Docker swarmMode, selecionar traefik.docker.network explicitamente.
TRAEFIK_NETWORK_LABEL=traefik.swarm.network

# Estado NAO pode migrar silenciosamente para outro no com volume local vazio.
# Preprovisionar volume externo UID/GID1000,0700 e arquivos privados0600,
# .fdl-volume-id com ID abaixo e banco/bootstrap offline antes do servico subir.
FDL_DATA_NODE=HOSTNAME_SWARM_DO_NO_PREPARADO
FDL_DATA_VOLUME=NOME_VOLUME_EXTERNO_PREPARADO
FDL_DATA_VOLUME_ID=IDENTIFICADOR_UNICO_DO_VOLUME_PREPARADO

# LOCAL apenas: definir no ambiente do processo, nao publicar na stack.
# FDL_PORT=5173
# FDL_DATA_DIR=CAMINHO_PRIVADO_DEDICADO_FORA_DA_APLICACAO_E_DO_BUILD
# Padrao Windows: LocalAppData/.fdl-data-flor-de-lotus-<hash-da-raiz>.
# Padrao POSIX: home/.fdl-data-flor-de-lotus-<hash-da-raiz>.
# Bind npm start:127.0.0.1; localhost/::1 recebe relay loopback no mesmo processo.
# Cada FDL_PORT gera origens locais coerentes sem editar hosts.

# Nenhuma senha em args/YAML/imagem/.env. Bootstrap operador por stdin protegido,
# offline, volume montado no mesmo UID1000; jamais contra servico ativo.
# Credenciais Registry ficam no cadastro seguro do Portainer. Porta5000 nao
# determina HTTP; TLS/confianca/pull multi-no sao configuracoes futuras do admin.
# Wildcard/default existente: remover as DUAS labels certresolver de stack.yml.
# Direitos de publicacao das imagens/artes/capas ainda precisam ser confirmados.
